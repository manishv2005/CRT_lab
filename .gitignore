# ==========================================================================
# Central .gitignore for CRT_project
# Covers: React / Vite, Node.js, Python, OS & Editor artifacts across all projects
# ==========================================================================

# Dependencies (Node / npm / pnpm / yarn)
node_modules/
*/node_modules/
*/*/node_modules/
.pnp
.pnp.js

# Production Build Artifacts
dist/
*/dist/
build/
*/build/
.output/

# Vite & Development Caches
.vite/
*/.vite/
.parcel-cache
.cache/

# Environment Variables & Secret Files
.env
.env.*
!.env.example
*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Python Artifacts (if running local python servers)
__pycache__/
*/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
.venv/

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# IDE & Editor Configurations
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Temporary and Scratch Files
*.tmp
*.temp
*~
